<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
 <application>
  <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="incident_alerts"/>
  <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_alert"/>
  <service android:name=".GuardMessagingService" android:exported="false"><intent-filter><action android:name="com.google.firebase.MESSAGING_EVENT"/></intent-filter></service>
 </application>
</manifest>
