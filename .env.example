NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/vanrakshak
PGSSL=false
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_NAME=Forest Administrator
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-with-a-strong-password
AI_WEBHOOK_SECRET=replace-with-a-random-ai-key
AI_DETECTION_MIN_CONFIDENCE=0.5
SENSOR_WEBHOOK_SECRET=replace-with-a-random-sensor-key
DEMO_MODE=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

ENABLE_DISPATCH_WORKER=true
TEAM_LOCATION_MAX_AGE_MINUTES=60
PUSH_ENABLED=false
# Set only on the server; never commit service-account credentials.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
